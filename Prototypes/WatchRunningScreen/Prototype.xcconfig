// PROTOTYPE, throwaway. A watch-only app for judging the running screen on a real Series 8.
SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
TARGETED_DEVICE_FAMILY = 4
WATCHOS_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Temper Proto
INFOPLIST_KEY_WKApplication = YES
INFOPLIST_KEY_WKWatchOnly = YES
PRODUCT_NAME = $(TARGET_NAME)
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// Real values live in Temper's git-ignored Config/Local.xcconfig.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = org.example
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).temper.watchprototype
#include? "../../Config/Local.xcconfig"
