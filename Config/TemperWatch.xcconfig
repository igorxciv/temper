// The Watch app's settings, on top of Base.xcconfig at the project level. It ships only inside the iPhone app.

SDKROOT = watchos
SUPPORTED_PLATFORMS = watchos watchsimulator
// The Series 8 stays on watchOS 26, because watchOS 27 drops it.
WATCHOS_DEPLOYMENT_TARGET = 26.0

// A Watch app's bundle ID has to start with its iPhone app's, which Base.xcconfig makes $(BUNDLE_ID_PREFIX).temper.
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).temper.watchkitapp
INFOPLIST_KEY_WKCompanionAppBundleIdentifier = $(BUNDLE_ID_PREFIX).temper

CODE_SIGN_ENTITLEMENTS = Config/TemperWatch.entitlements
