// PROTOTYPE, throwaway. An empty iPhone app whose only job is to carry the Watch app onto the Watch.
#include "Prototype.xcconfig"

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 27.0
INFOPLIST_KEY_CFBundleDisplayName = Temper Proto
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
PRODUCT_BUNDLE_IDENTIFIER = $(HOST_BUNDLE_ID)
