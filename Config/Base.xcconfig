SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
// Embedding the signed widget extension can't strip it, so skip the strip and its warning.
// Archives still strip through STRIP_INSTALLED_PRODUCT.
COPY_PHASE_STRIP = NO

IPHONEOS_DEPLOYMENT_TARGET = 27.0
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES

MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// Real values live in the git-ignored Local.xcconfig. See Local.xcconfig.example.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = org.example
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).$(TARGET_NAME:lower)

// Only the app signs with entitlements. Keyed by target name, the setting is empty for the test bundle, which has
// no xcconfig of its own, and TemperWidgets.xcconfig clears it too.
TEMPER_ENTITLEMENTS_Temper = Config/Temper.entitlements
CODE_SIGN_ENTITLEMENTS = $(TEMPER_ENTITLEMENTS_$(TARGET_NAME))
#include? "Local.xcconfig"
