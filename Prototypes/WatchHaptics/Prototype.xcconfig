// PROTOTYPE, throwaway. Settings both targets share. Answers which wrist haptic marks each Cue kind (issue #112).
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
ALWAYS_SEARCH_USER_PATHS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = YES
PRODUCT_NAME = $(TARGET_NAME)
MARKETING_VERSION = 0.1
CURRENT_PROJECT_VERSION = 1

// Real values live in Temper's git-ignored Config/Local.xcconfig.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = org.example
HOST_BUNDLE_ID = $(BUNDLE_ID_PREFIX).temper.hapticsprototype
#include? "../../Config/Local.xcconfig"
// A signed Watch app can't be stripped while it's embedded, so skip the strip and its warning, as Temper does.
COPY_PHASE_STRIP = NO
